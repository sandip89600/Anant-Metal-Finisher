# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas in production, local MongoDB for development)
MONGODB_URI=mongodb://127.0.0.1:27017/anant_metal_finishers

# JWT Authentication
JWT_SECRET=replace_with_a_secure_random_string_at_least_32_characters_long
JWT_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_a_secure_cookie_signature_string_2026

# Allowed Frontend Origins (comma-separated in production)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Outbound Email Notifications (Nodemailer SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=your_smtp_app_password
EMAIL_FROM=no-reply@anantmetalfinishers.com
NOTIFICATION_EMAIL=admin@anantmetalfinishers.com

# Initial Administrator Setup (for scripts/seedAdmin.js)
INITIAL_ADMIN_EMAIL=admin@anantmetalfinishers.com
INITIAL_ADMIN_PASSWORD=AmpNashik@2026AdminSecure!
INITIAL_ADMIN_NAME=AMP Operations Desk
